# ─── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_USER=facturacion_user
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=facturacion_db

# Construida automáticamente en docker-compose, pero útil para conexión local:
DATABASE_URL=postgresql://facturacion_user:cambia_esta_password@localhost:5432/facturacion_db

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
# Generá una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_en_produccion_por_una_clave_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
